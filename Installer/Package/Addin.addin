<?xml version="1.0" encoding="utf-8"?>
<!--
  FabFlow .addin manifest.

  Sits inside FabFlow.bundle\Contents\ alongside the DLL, so the
  Assembly path is relative - no install-time patching required.
-->
<Addin Type="Standard">
  <ClassId>{9889EC7F-AA24-4569-BD57-C5B0038466F5}</ClassId>
  <ClientId>{9889EC7F-AA24-4569-BD57-C5B0038466F5}</ClientId>
  <DisplayName>FabFlow Addin</DisplayName>
  <Description>FabFlow productivity tools for Autodesk Inventor.</Description>
  <Assembly>RMAC Efficiency Addin.dll</Assembly>
  <LoadOnStartUp>1</LoadOnStartUp>
  <UserUnloadable>1</UserUnloadable>
</Addin>
