<?xml version="1.0" encoding="utf-8"?>
<!--
  FabFlow.bundle / PackageContents.xml
  ====================================
  Autodesk ApplicationPlugins bundle manifest.

  Installed to: %ProgramData%\Autodesk\ApplicationPlugins\FabFlow.bundle\
  Scanned by all Inventor versions from a single shared location, so the
  MSI no longer needs to care which Inventor versions are present.

  SeriesMin/SeriesMax declare the supported Inventor range (2024–2027).
  Bump SeriesMax when adding a new Inventor version.
-->
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="Inventor"
                    Name="FabFlow"
                    Description="FabFlow productivity tools for Autodesk Inventor"
                    AppVersion="1.0.0"
                    FriendlyVersion="1.0"
                    ProductType="Application"
                    SupportedLocales="Enu">

  <CompanyDetails Name="FabFlow"
                  Url="https://fabflow.com.au"
                  Email="support@fabflow.com.au" />

  <Components Description="FabFlow Addin">
    <RuntimeRequirements OS="Win64"
                         Platform="Inventor"
                         SeriesMin="R2025"
                         SeriesMax="R2027" />
    <ComponentEntry AppName="FabFlow Addin"
                    ModuleName="./Contents/FabFlow.addin"
                    AppDescription="FabFlow productivity tools for Autodesk Inventor"
                    LoadOnAutoCADStartup="True" />
  </Components>

</ApplicationPackage>
