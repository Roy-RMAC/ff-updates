<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <DefineConstants>AddinVersion=$(AddinVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Package project so $(var.Package.TargetPath) resolves to the MSI -->
    <ProjectReference Include="..\Package\Package.wixproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <BootstrapperApplicationContent Include="license.rtf" />
  </ItemGroup>

</Project>
