<Project Sdk="Microsoft.NET.Sdk">

	<!-- Core project properties -->
	<PropertyGroup>
		<Configurations>Debug;Release;Installer</Configurations>
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<UseWindowsForms>true</UseWindowsForms>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Nullable>enable</Nullable>

		<ProjectType>Local</ProjectType>
		<DelaySign>false</DelaySign>
		<OutputType>Library</OutputType>
		<RootNamespace>RMAC_Efficiency_Addin</RootNamespace>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AssemblyVersion>$(AddinVersion)</AssemblyVersion>
		<FileVersion>$(AddinVersion)</FileVersion>

		<AssemblyKeyContainerName></AssemblyKeyContainerName>
		<AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
		<DefaultClientScript>JScript</DefaultClientScript>
		<DefaultHTMLPageLayout>Grid</DefaultHTMLPageLayout>
		<DefaultTargetSchema>IE50</DefaultTargetSchema>
		<StartupObject></StartupObject>

		<!-- Inventor addin metadata -->
		<AddinGuid>9889ec7f-aa24-4569-bd57-c5b0038466f5</AddinGuid>
		<AddinDisplayName>FabFlow Addin</AddinDisplayName>
		<AddinDescription>FabFlow productivity tools for Autodesk Inventor.</AddinDescription>
		<AddinFileName>FabFlow.addin</AddinFileName>

		<!-- Debug deployment targets the Autodesk ApplicationPlugins bundle location
		     (user scope, no admin required). This single location is scanned by all
		     supported Inventor versions (2025, 2026, 2027), so one write covers the
		     entire test matrix. Mirrors the MSI installer's bundle layout. -->
		<FabFlowBundleDir>$(APPDATA)\Autodesk\ApplicationPlugins\FabFlow.bundle</FabFlowBundleDir>
		<FabFlowBundleContentsDir>$(FabFlowBundleDir)\Contents</FabFlowBundleContentsDir>
		<AddinFullPath>$(FabFlowBundleContentsDir)\$(AddinFileName)</AddinFullPath>
		<PackageContentsSource>$(MSBuildThisFileDirectory)..\Installer\Package\PackageContents.xml</PackageContentsSource>
		<AddinGuidUpper>$([System.String]::Copy('$(AddinGuid)').ToUpperInvariant())</AddinGuidUpper>
	</PropertyGroup>

	<!-- Debug configuration -->
	<!-- Note: Debug defines TEST_HARNESS so the self-test runner is always available
	     in dev builds. Release and Installer builds never define it, so customers
	     never see test code. See Tests\RunOneVersion.bat for how the harness is triggered. -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<BaseAddress>285212672</BaseAddress>
		<ConfigurationOverrideFile></ConfigurationOverrideFile>
		<DocumentationFile></DocumentationFile>
		<FileAlignment>4096</FileAlignment>
		<NoStdLib>false</NoStdLib>
		<NoWarn></NoWarn>
		<RegisterForComInterop>false</RegisterForComInterop>
		<RemoveIntegerChecks>false</RemoveIntegerChecks>
		<CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
		<DefineConstants>$(DefineConstants);TEST_HARNESS</DefineConstants>

		<!-- Debug output stays in your Deploy folder -->
		<OutputPath>..\..\Deploy\</OutputPath>
	</PropertyGroup>

	<!-- Release configuration -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<BaseAddress>285212672</BaseAddress>
		<ConfigurationOverrideFile></ConfigurationOverrideFile>
		<DocumentationFile></DocumentationFile>
		<FileAlignment>4096</FileAlignment>
		<NoStdLib>false</NoStdLib>
		<NoWarn></NoWarn>
		<RegisterForComInterop>false</RegisterForComInterop>
		<RemoveIntegerChecks>false</RemoveIntegerChecks>
		<DebugType>none</DebugType>
		<CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>

		<!-- Release output goes to the live Inventor addins folder -->
		<OutputPath>D:\RMAC Design Data\Inventor\Addins\RMAC Efficency</OutputPath>
	</PropertyGroup>

	<!-- Installer configuration (for WiX MSI packaging) -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Installer|AnyCPU'">
		<OutputPath>..\InstallerBuild\</OutputPath>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- Resource cleanup -->
	<ItemGroup>
		<None Remove="Resources\ChatGPT Image Jan 25, 2026, 10_44_27 PM.png" />
		<None Remove="Resources\thickness_from_line_32x32.png" />
		<None Remove="Resources\Turn Off Sketches.png" />
		<None Remove="Resources\Turn On Sketches.png" />
	</ItemGroup>

	<!-- COM reference -->
	<ItemGroup>
		<COMReference Include="stdole">
			<WrapperTool>tlbimp</WrapperTool>
			<VersionMinor>0</VersionMinor>
			<VersionMajor>2</VersionMajor>
			<Guid>00020430-0000-0000-c000-000000000046</Guid>
			<Lcid>0</Lcid>
			<Isolated>false</Isolated>
			<EmbedInteropTypes>true</EmbedInteropTypes>
		</COMReference>
	</ItemGroup>

	<!-- Embedded resources -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\ChatGPT Image Jan 25, 2026, 10_44_27 PM.png" />
		<EmbeddedResource Include="Resources\thickness_from_line_32x32.png" />
		<EmbeddedResource Include="Resources\Turn Off Sketches.png" />
		<EmbeddedResource Include="Resources\Turn On Sketches.png" />
	</ItemGroup>

	<ItemGroup>
		<None Include="RMAC Efficiency Addin.X.manifest" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Autodesk.RMAC Efficiency Addin.Inventor.addin" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Readme.txt" />
	</ItemGroup>

	<!-- Krypton Toolkit (modern WinForms theming) -->
	<ItemGroup>
		<PackageReference Include="Krypton.Toolkit" Version="100.26.1.19" />
		<PackageReference Include="Krypton.Navigator" Version="100.26.1.19" />
	</ItemGroup>

	<!-- DXF file manipulation (replaces external AutoCAD-based post-processor) -->
	<ItemGroup>
		<PackageReference Include="IxMilia.Dxf" Version="0.8.4" />
	</ItemGroup>

	<!-- PDF merging (replaces Adobe Acrobat COM dependency) -->
	<ItemGroup>
		<PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
	</ItemGroup>

	<!-- WMI queries for machine fingerprint (licensing) -->
	<ItemGroup>
		<PackageReference Include="System.Management" Version="8.*" />
	</ItemGroup>

	<!-- Inventor interop reference: prefer local install, fall back to lib/ for CI -->
	<PropertyGroup>
		<InventorInteropPath Condition="Exists('$(ProgramW6432)\Autodesk\Inventor 2025\Bin\Autodesk.Inventor.Interop.dll')">$(ProgramW6432)\Autodesk\Inventor 2025\Bin\Autodesk.Inventor.Interop.dll</InventorInteropPath>
		<InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(MSBuildThisFileDirectory)..\lib\Autodesk.Inventor.Interop.dll</InventorInteropPath>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="Autodesk.Inventor.Interop">
			<HintPath>$(InventorInteropPath)</HintPath>
			<EmbedInteropTypes>False</EmbedInteropTypes>
			<Private>True</Private>
		</Reference>
	</ItemGroup>

	<!-- Resources designer -->
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<!-- ============================================================================
	     Deploy the add-in to Autodesk's shared ApplicationPlugins bundle location
	     after every non-Installer build.

	     Layout produced (in %APPDATA%\Autodesk\ApplicationPlugins\):
	       FabFlow.bundle\
	         PackageContents.xml     (copied from Installer\Package\)
	         Contents\
	           FabFlow.addin         (generated here, Assembly = absolute DLL path)

	     The Assembly path points at $(TargetPath) in the Deploy folder, so the
	     DLL doesn't need to be copied anywhere - Inventor loads it in-place on
	     next startup. Rebuild → relaunch Inventor → latest code runs.

	     One deployment covers Inventor 2025/2026/2027 since they all scan the
	     ApplicationPlugins folder.
	     ============================================================================ -->
	<Target Name="DeployFabFlowBundle" AfterTargets="Build" Condition="'$(Configuration)' != 'Installer'">
		<MakeDir Directories="$(FabFlowBundleDir);$(FabFlowBundleContentsDir)" />

		<!-- Copy the canonical PackageContents.xml from the Installer project.
		     Using the same file as the MSI ensures debug and release deployments
		     declare the identical supported version range. -->
		<Copy SourceFiles="$(PackageContentsSource)"
		      DestinationFolder="$(FabFlowBundleDir)"
		      SkipUnchangedFiles="true"
		      OverwriteReadOnlyFiles="true" />

		<!-- Generate FabFlow.addin pointing at the just-built DLL.
		     Absolute Assembly path means we don't have to copy the DLL into the bundle. -->
		<ItemGroup>
			<AddinLines Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
			<AddinLines Include="&lt;Addin Type=&quot;Standard&quot;&gt;" />
			<AddinLines Include="  &lt;ClassId&gt;{$(AddinGuidUpper)}&lt;/ClassId&gt;" />
			<AddinLines Include="  &lt;ClientId&gt;{$(AddinGuidUpper)}&lt;/ClientId&gt;" />
			<AddinLines Include="  &lt;DisplayName&gt;$(AddinDisplayName)&lt;/DisplayName&gt;" />
			<AddinLines Include="  &lt;Description&gt;$(AddinDescription)&lt;/Description&gt;" />
			<AddinLines Include="  &lt;Assembly&gt;$(TargetPath)&lt;/Assembly&gt;" />
			<AddinLines Include="  &lt;LoadOnStartUp&gt;1&lt;/LoadOnStartUp&gt;" />
			<AddinLines Include="  &lt;UserUnloadable&gt;1&lt;/UserUnloadable&gt;" />
			<AddinLines Include="&lt;/Addin&gt;" />
		</ItemGroup>

		<WriteLinesToFile File="$(AddinFullPath)" Lines="@(AddinLines)" Overwrite="true" Encoding="UTF-8" />

		<Message Text="FabFlow bundle deployed to $(FabFlowBundleDir)" Importance="high" />
	</Target>

	<!-- Obfuscate the assembly after Installer builds (before WiX packaging) -->
	<Target Name="ObfuscateAssembly" AfterTargets="Build" Condition="'$(Configuration)' == 'Installer'">
		<Message Text="Restoring Obfuscar dotnet tool..." Importance="high" />
		<Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory).." />

		<Message Text="Obfuscating $(TargetFileName)..." Importance="high" />
		<Exec Command="dotnet obfuscar.console obfuscar.xml" WorkingDirectory="$(MSBuildThisFileDirectory).." />

		<!-- Replace the original DLL with the obfuscated version -->
		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\InstallerBuild\Obfuscated\$(TargetFileName)"
		      DestinationFiles="$(TargetPath)"
		      OverwriteReadOnlyFiles="true" />

		<Message Text="Obfuscation complete: $(TargetFileName)" Importance="high" />
	</Target>

	</Project>
