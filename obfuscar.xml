<?xml version='1.0'?>
<Obfuscator>
  <!-- Input/output paths (relative to this file) -->
  <Var name="InPath" value="InstallerBuild" />
  <Var name="OutPath" value="InstallerBuild\Obfuscated" />

  <!-- Rename only - no other transformations -->
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="false" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="UseKoreanNames" value="false" />
  <Var name="ReuseNames" value="true" />

  <!-- Only obfuscate our assembly, not third-party DLLs -->
  <Module file="$(InPath)\RMAC Efficiency Addin.dll">

    <!-- === COM ENTRY POINT - Must be preserved exactly === -->
    <!-- Inventor loads via COM using this class GUID and ProgId -->
    <SkipType name="RMAC_Efficiency_Addin.StandardAddInServer" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" />

    <!-- Interface implemented by StandardAddInServer - must match skip rules -->
    <SkipType name="RMAC_Efficiency_Addin.UI.IRmacCommandCallbacks" skipMethods="true" />

    <!-- === Preserve types referenced by Windows Forms designer === -->
    <!-- Forms use InitializeComponent which references types by name -->
    <SkipNamespace name="RMAC_Efficiency_Addin.Properties" />

  </Module>
</Obfuscator>
